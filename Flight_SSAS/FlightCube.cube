          <FormatString>#,0.00</FormatString>
        </Measure>
        <Measure>
          <ID>Carrier Delay Minutes</ID>
          <Name>Carrier Delay Minutes</Name>
          <DataType>Double</DataType>
          <Source>
            <DataType>Double</DataType>
            <NullProcessing>ZeroOrBlank</NullProcessing>
            <Source xsi:type="ColumnBinding">
              <TableID>FactFlight</TableID>
              <ColumnID>CARRIER_DELAY</ColumnID>
            </Source>
          </Source>
          <DisplayFolder>Delays</DisplayFolder>
          <FormatString>#,0.00</FormatString>
        </Measure>
        <Measure>
          <ID>Weather Delay Minutes</ID>
          <Name>Weather Delay Minutes</Name>
          <DataType>Double</DataType>
          <Source>
            <DataType>Double</DataType>
