              <ColumnID>DELAYED_DEPARTURES</ColumnID>
            </Source>
          </Source>
          <DisplayFolder>Flights</DisplayFolder>
          <FormatString>#,0</FormatString>
        </Measure>
        <Measure>
          <ID>Departure Delay Minutes</ID>
