          <DisplayFolder>Flights</DisplayFolder>
          <FormatString>#,0</FormatString>
        </Measure>
        <Measure>
          <ID>Departure Observations</ID>
          <Name>Departure Observations</Name>
          <DataType>BigInt</DataType>
          <Source>
            <DataType>BigInt</DataType>
            <NullProcessing>ZeroOrBlank</NullProcessing>
            <Source xsi:type="ColumnBinding">
              <TableID>FactFlight</TableID>
              <ColumnID>DEPARTURE_OBSERVATIONS</ColumnID>
            </Source>
          </Source>
          <DisplayFolder>Flights</DisplayFolder>
          <FormatString>#,0</FormatString>
        </Measure>
        <Measure>
          <ID>Arrival Observations</ID>
          <Name>Arrival Observations</Name>
          <DataType>BigInt</DataType>
          <Source>
            <DataType>BigInt</DataType>
            <NullProcessing>ZeroOrBlank</NullProcessing>
            <Source xsi:type="ColumnBinding">
              <TableID>FactFlight</TableID>
              <ColumnID>ARRIVAL_OBSERVATIONS</ColumnID>
            </Source>
          </Source>
          <DisplayFolder>Flights</DisplayFolder>
          <FormatString>#,0</FormatString>
