                    <TableID>FactFlight</TableID>
                    <ColumnID>ORIGIN_AIRPORT_ID</ColumnID>
                  </Source>
                </KeyColumn>
              </KeyColumns>
              <Type>Granularity</Type>
            </Attribute>
          </Attributes>
        </Dimension>
        <Dimension xsi:type="RegularMeasureGroupDimension">
          <CubeDimensionID>Destination Airport</CubeDimensionID>
          <Attributes>
            <Attribute>
              <AttributeID>Airport</AttributeID>
              <KeyColumns>
                <KeyColumn>
                  <DataType>Integer</DataType>
                  <NullProcessing>Error</NullProcessing>
                  <Source xsi:type="ColumnBinding">
                    <TableID>FactFlight</TableID>
                    <ColumnID>DEST_AIRPORT_ID</ColumnID>
                  </Source>
                </KeyColumn>
              </KeyColumns>
              <Type>Granularity</Type>
            </Attribute>
          </Attributes>
        </Dimension>
        <Dimension xsi:type="RegularMeasureGroupDimension">
          <CubeDimensionID>Departure Time</CubeDimensionID>
          <Attributes>
            <Attribute>
              <AttributeID>Scheduled Time</AttributeID>
              <KeyColumns>
                <KeyColumn>
                  <DataType>Integer</DataType>
                  <NullProcessing>Error</NullProcessing>
                  <Source xsi:type="ColumnBinding">
                    <TableID>FactFlight</TableID>
                    <ColumnID>DEP_TIME_ID</ColumnID>
                  </Source>
                </KeyColumn>
              </KeyColumns>
              <Type>Granularity</Type>
            </Attribute>
          </Attributes>
        </Dimension>
        <Dimension xsi:type="RegularMeasureGroupDimension">
          <CubeDimensionID>Cancellation</CubeDimensionID>
          <Attributes>
            <Attribute>
              <AttributeID>Cancellation</AttributeID>
              <KeyColumns>
                <KeyColumn>
                  <DataType>Integer</DataType>
                  <NullProcessing>Error</NullProcessing>
                  <Source xsi:type="ColumnBinding">
                    <TableID>FactFlight</TableID>
                    <ColumnID>CANCELLATION_ID</ColumnID>
                  </Source>
                </KeyColumn>
              </KeyColumns>
              <Type>Granularity</Type>
            </Attribute>
          </Attributes>
        </Dimension>
        <Dimension xsi:type="RegularMeasureGroupDimension">
          <CubeDimensionID>Route</CubeDimensionID>
          <Attributes>
            <Attribute>
              <AttributeID>Route</AttributeID>
              <KeyColumns>
                <KeyColumn>
                  <DataType>WChar</DataType>
                  <DataSize>50</DataSize>
                  <NullProcessing>Error</NullProcessing>
                  <Source xsi:type="ColumnBinding">
                    <TableID>FactFlight</TableID>
                    <ColumnID>ROUTE_KEY</ColumnID>
                  </Source>
                </KeyColumn>
              </KeyColumns>
              <Type>Granularity</Type>
            </Attribute>
          </Attributes>
        </Dimension>
        <Dimension xsi:type="RegularMeasureGroupDimension">
          <CubeDimensionID>Flight Status</CubeDimensionID>
          <Attributes>
            <Attribute>
              <AttributeID>Status</AttributeID>
              <KeyColumns>
                <KeyColumn>
                  <DataType>Integer</DataType>
                  <NullProcessing>Error</NullProcessing>
                  <Source xsi:type="ColumnBinding">
                    <TableID>FactFlight</TableID>
                    <ColumnID>CANCELLED</ColumnID>
                  </Source>
                </KeyColumn>
              </KeyColumns>
              <Type>Granularity</Type>
            </Attribute>
          </Attributes>
        </Dimension>
      </Dimensions>
    </MeasureGroup>
  </MeasureGroups>
  <Source>
    <DataSourceViewID>Flight_DW</DataSourceViewID>
  </Source>
  <MdxScripts>
    <MdxScript>
      <ID>Calculations</ID>
      <Name>Calculations</Name>
      <Commands>
        <Command>
          <Text>CALCULATE;
CREATE MEMBER CURRENTCUBE.[Measures].[Average Arrival Delay] AS
 IIF([Measures].[Arrival Observations]=0,NULL,[Measures].[Arrival Delay Sum]/[Measures].[Arrival Observations]),
 FORMAT_STRING='#,0.00',DISPLAY_FOLDER='Rates and Averages',VISIBLE=1;
CREATE MEMBER CURRENTCUBE.[Measures].[Average Departure Delay] AS
 IIF([Measures].[Departure Observations]=0,NULL,[Measures].[Departure Delay Sum]/[Measures].[Departure Observations]),
 FORMAT_STRING='#,0.00',DISPLAY_FOLDER='Rates and Averages',VISIBLE=1;
CREATE MEMBER CURRENTCUBE.[Measures].[Cancellation Rate] AS
 IIF([Measures].[Total Flights]=0,NULL,[Measures].[Cancelled Flights]/[Measures].[Total Flights]),
 FORMAT_STRING='0.00%',DISPLAY_FOLDER='Rates and Averages',VISIBLE=1;
CREATE MEMBER CURRENTCUBE.[Measures].[Departure Delay Rate] AS
 IIF([Measures].[Departure Observations]=0,NULL,[Measures].[Delayed Departures]/[Measures].[Departure Observations]),
 FORMAT_STRING='0.00%',DISPLAY_FOLDER='Rates and Averages',VISIBLE=1;
CREATE MEMBER CURRENTCUBE.[Measures].[Route Distance Miles] AS
 IIF([Measures].[Total Flights]=0,NULL,[Measures].[Distance Miles Sum]/[Measures].[Total Flights]),
 FORMAT_STRING='#,0.00',DISPLAY_FOLDER='Distance',VISIBLE=1;</Text>
        </Command>
      </Commands>
    </MdxScript>
  </MdxScripts>
</Cube>