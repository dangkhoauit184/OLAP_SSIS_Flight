    <DTS:Executable
      DTS:refId="Package\Verify_Load"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Verify source/Fact row counts, Dimension keys and six foreign keys."
      DTS:DTSID="{1542EA29-A70F-5201-AB38-733F603F0095}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:ObjectName="Verify_Load"
      DTS:DelayValidation="True">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask"
          SQLTask:Connection="{6B0EB960-A0A4-4407-B30A-D5C4728944F8}"
          SQLTask:SqlStatementSource="SET NOCOUNT ON;&#xA;DECLARE @SourceRows INT;&#xA;SET @SourceRows = ?;&#xA;IF @SourceRows &lt;= 0&#xA;    THROW 51000, 'The CSV source is empty; the warehouse load is not valid.', 1;&#xA;IF (SELECT COUNT_BIG(*) FROM dbo.FACT_FLIGHT) &lt;&gt; @SourceRows&#xA;    THROW 51001, 'Fact row count does not match the CSV source row count.', 1;&#xA;IF EXISTS (SELECT 1 FROM dbo.FACT_FLIGHT WHERE DATE_ID IS NULL OR DEP_TIME_ID IS NULL OR CARRIER_ID IS NULL OR ORIGIN_AIRPORT_ID IS NULL OR DEST_AIRPORT_ID IS NULL OR CANCELLATION_ID IS NULL)&#xA;    THROW 51002, 'Fact contains a missing Dimension key.', 1;&#xA;IF (SELECT COUNT(*) FROM sys.foreign_keys WHERE parent_object_id = OBJECT_ID('dbo.FACT_FLIGHT') AND is_disabled = 0 AND is_not_trusted = 0) &lt;&gt; 6&#xA;    THROW 51003, 'All six enabled and trusted Fact foreign keys are required.', 1;&#xA;"
          SQLTask:BypassPrepare="True">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::SourceRowCount"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="-1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
